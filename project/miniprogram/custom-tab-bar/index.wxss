.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 56rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(24, 33, 26, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 46rpx;
  color: #8a9189;
  transition: all 0.25s ease;
}

.tab-item.active {
  background: #eff4e5;
  color: #18211a;
}

.icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.tab-item.active .icon-wrap {
  width: 58rpx;
  height: 58rpx;
  background: #d7ff5e;
}

.tab-icon {
  width: 38rpx;
  height: 38rpx;
}

.tab-item.active .tab-icon {
  width: 36rpx;
  height: 36rpx;
}

.tab-text {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.tab-item.active .tab-text {
  font-weight: 800;
}
