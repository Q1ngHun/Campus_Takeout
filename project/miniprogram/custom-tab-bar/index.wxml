<view class="tabbar-wrap" wx:if="{{!hidden}}">
  <view class="tabbar">
    <view
      class="tab-item {{selected === index ? 'active' : ''}}"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="icon-wrap">
        <image class="tab-icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
  <view class="tabbar-safe"></view>
</view>
