.detail-page {
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
  background: radial-gradient(circle at 88% 0%, rgba(215, 255, 94, 0.18) 0, rgba(244, 242, 236, 0) 34%), #f4f2ec;
}

.detail-nav {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-nav .nav-back {
  margin-left: -14rpx;
}

.detail-nav-title {
  font-size: 30rpx;
  font-weight: 700;
}

button.nav-share {
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  box-sizing: border-box;
  flex-shrink: 0;
}

.nav-share image {
  width: 29rpx;
  height: 29rpx;
}

.success-banner {
  position: relative;
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin: 12rpx 32rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  background: #d7ff5e;
  overflow: hidden;
  animation: fadeUp 0.45s ease both;
}

.success-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #18211a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-icon image {
  width: 28rpx;
  height: 28rpx;
}

.success-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.success-title {
  font-size: 25rpx;
  font-weight: 900;
  color: #18211a;
}

.success-desc {
  margin-top: 3rpx;
  color: #586632;
  font-size: 18rpx;
}

.success-spark {
  color: #586632;
  font-size: 38rpx;
}

.detail-hero {
  position: relative;
  margin: 20rpx 32rpx 0;
  padding: 28rpx;
  border-radius: 38rpx;
  background: #14251b;
  overflow: hidden;
  box-shadow: 0 20rpx 44rpx rgba(20, 37, 27, 0.18);
}

.detail-hero-glow {
  position: absolute;
  right: -120rpx;
  top: -160rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(215, 255, 94, 0.17) 0, rgba(20, 37, 27, 0) 68%);
}

.detail-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-live {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #d7ff5e;
  font-size: 20rpx;
  font-weight: 700;
}

.live-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #d7ff5e;
}

.detail-id {
  color: #6e7d6b;
  font-size: 16rpx;
  letter-spacing: 0.5rpx;
}

.detail-title-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.detail-status-title {
  color: #ffffff;
  font-size: 45rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}

.detail-status-badge {
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: rgba(215, 255, 94, 0.12);
  color: #d7ff5e;
  font-size: 13rpx;
  letter-spacing: 1rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.detail-status-desc {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 8rpx;
  color: #9ba997;
  font-size: 19rpx;
}

.progress-rail {
  position: relative;
  z-index: 2;
  display: flex;
  margin-top: 28rpx;
}

.progress-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-track {
  position: relative;
  width: 100%;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot {
  position: relative;
  z-index: 2;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #334034;
  border: 2rpx solid #455244;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot.done {
  background: #d7ff5e;
  border-color: #d7ff5e;
}

.step-dot.current {
  box-shadow: 0 0 0 7rpx rgba(215, 255, 94, 0.13);
}

.dot-core {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #14251b;
}

.step-dot:not(.done) .dot-core {
  background: transparent;
}

.step-line {
  position: absolute;
  left: 50%;
  width: 100%;
  height: 2rpx;
  background: #334034;
}

.step-line.done {
  background: #d7ff5e;
}

.step-name {
  margin-top: 7rpx;
  color: #647361;
  font-size: 15rpx;
}

.step-name.done {
  color: #d7ff5e;
}

.detail-shop {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
}

.detail-shop image {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
}

.detail-shop-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.detail-shop-name {
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
}

.detail-shop-note {
  margin-top: 4rpx;
  color: #81907f;
  font-size: 16rpx;
}

.detail-shop-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-shop-arrow image {
  width: 19rpx;
  height: 19rpx;
  filter: invert(1);
  opacity: 0.4;
}

.rider-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 20rpx 32rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(24, 33, 26, 0.045);
}

.rider-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f1d7b7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.rider-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rider-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rider-name {
  font-size: 24rpx;
  font-weight: 800;
}

.rider-tag {
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 5rpx;
  background: #f1f3ed;
  color: #7d8877;
  font-size: 14rpx;
  display: flex;
  align-items: center;
}

.rider-status {
  margin-top: 5rpx;
  color: #9da39a;
  font-size: 17rpx;
}

.rider-btn {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #18211a;
  color: #d7ff5e;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.rider-btn image {
  width: 22rpx;
  height: 22rpx;
}

.timeline-card,
.address-card,
.goods-card,
.info-card {
  margin: 20rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(24, 33, 26, 0.04);
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 27rpx;
  font-weight: 800;
}

.card-sub {
  color: #a9afa6;
  font-size: 15rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
}

.timeline-list {
  padding: 2rpx 0;
}

.detail-van-steps {
  padding: 8rpx 0 0;
  background: transparent;
  font-size: 22rpx;
}

.detail-van-steps .van-step__title {
  font-size: 23rpx;
  font-weight: 700;
}

.detail-van-steps .desc-class {
  margin-top: 4rpx;
  color: #9aa197;
  font-size: 18rpx;
}

.timeline-item {
  display: flex;
  gap: 14rpx;
  min-height: 62rpx;
}

.timeline-rail {
  width: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 7rpx;
}

.timeline-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d8d6ce;
  flex-shrink: 0;
}

.timeline-dot.done {
  background: #bbc1b8;
}

.timeline-dot.active {
  background: #b9e83e;
  box-shadow: 0 0 0 5rpx rgba(185, 232, 62, 0.2);
}

.timeline-line {
  flex: 1;
  width: 1rpx;
  background: #e9e7e0;
  margin: 5rpx 0;
}

.timeline-copy {
  flex: 1;
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  padding-bottom: 16rpx;
}

.timeline-text {
  font-size: 21rpx;
  color: #8f978d;
}

.timeline-text.active {
  color: #283228;
  font-weight: 800;
}

.timeline-time {
  color: #b0b5ad;
  font-size: 17rpx;
}

.address-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.address-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #eef6d8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.address-icon image {
  width: 29rpx;
  height: 29rpx;
}

.address-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.address-label {
  color: #9ba198;
  font-size: 17rpx;
}

.address-detail {
  margin-top: 5rpx;
  color: #283228;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
}

.address-time {
  flex-shrink: 0;
  color: #a3a99f;
  font-size: 16rpx;
  text-align: right;
  line-height: 1.7;
}

.goods-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-bottom: 18rpx;
}

.goods-item > image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.goods-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 23rpx;
  font-weight: 700;
  color: #2c362c;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-spec {
  margin-top: 5rpx;
  color: #a0a69d;
  font-size: 17rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 5rpx;
}

.goods-qty {
  color: #a0a69d;
  font-size: 17rpx;
}

.goods-price {
  font-size: 22rpx;
  font-weight: 700;
}

.bill-line {
  height: 1rpx;
  background: #eeece5;
  margin: 4rpx 0 10rpx;
}

.bill-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 52rpx;
  color: #7f887e;
  font-size: 20rpx;
}

.bill-row.total {
  margin-top: 8rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e8e5dc;
  color: #283228;
  font-weight: 700;
}

.bill-total {
  font-family: "DIN Alternate", "Arial Black", sans-serif;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 56rpx;
  padding: 10rpx 0;
  color: #7c857b;
  font-size: 20rpx;
}

.info-label {
  flex-shrink: 0;
  color: #9ba198;
}

.info-value {
  text-align: right;
  color: #3d473e;
  font-size: 20rpx;
  word-break: break-all;
}

.copy-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.copy-btn {
  padding: 3rpx 10rpx;
  border-radius: 7rpx;
  background: #f2f3ee;
  color: #7e8778;
  font-size: 15rpx;
}

.detail-service {
  display: flex;
  margin: 20rpx 32rpx 0;
  padding: 22rpx 10rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(24, 33, 26, 0.04);
}

.service-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;
  color: #667066;
  font-size: 17rpx;
}

.service-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 17rpx;
  background: #f5f5ef;
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-icon image {
  width: 27rpx;
  height: 27rpx;
}

.detail-space {
  height: 22rpx;
}

.detail-actions {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 800;
  height: 104rpx;
  padding: 0 12rpx;
  border-radius: 52rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(24, 33, 26, 0.16);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-ghost-detail {
  flex: 1;
  height: 78rpx;
  border-radius: 39rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e4e1d9;
  color: #3f493f;
  font-size: 22rpx;
  font-weight: 700;
}

.action-primary-detail {
  flex: 1.4;
  height: 78rpx;
  border-radius: 39rpx;
  background: #18211a;
  color: #d7ff5e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.action-primary-detail image {
  width: 24rpx;
  height: 24rpx;
}
