<view class="page-plain settings-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px"></view>

  <view class="settings-nav">
    <view class="nav-back" bindtap="goBack">
      <image src="/assets/icons/chevron-left.svg" />
    </view>
    <text class="settings-nav-title">设置</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="settings-head">
    <text class="eyebrow">PREFERENCES</text>
    <view class="settings-title-row">
      <text class="settings-title">设置</text>
      <text class="settings-dot">.</text>
    </view>
    <text class="settings-sub">把宿达，调成你喜欢的样子</text>
  </view>

  <view class="profile-strip">
    <view class="profile-avatar">满</view>
    <view class="profile-copy">
      <text class="profile-name">林小满</text>
      <text class="profile-meta">青禾大学 · 已认证</text>
    </view>
    <view class="profile-badge">SUDA PRO</view>
  </view>

  <view class="settings-group">
    <view class="group-label">消息与通知</view>
    <view class="group-card">
      <view class="setting-row">
        <view class="setting-icon lime-bg">
          <image src="/assets/icons/bell.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">订单通知</text>
          <text class="setting-desc">骑手接单、送达提醒</text>
        </view>
        <van-switch checked="{{notify}}" active-color="#b9e83e" size="22px" data-field="notify" bind:change="toggle" />
      </view>
      <view class="row-line"></view>
      <view class="setting-row">
        <view class="setting-icon peach-bg">
          <image src="/assets/icons/message.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">声音与振动</text>
          <text class="setting-desc">新消息提示音</text>
        </view>
        <van-switch checked="{{sound}}" active-color="#b9e83e" size="22px" data-field="sound" bind:change="toggle" />
      </view>
      <view class="row-line"></view>
      <view class="setting-row">
        <view class="setting-icon mint-bg">
          <image src="/assets/icons/leaf.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">个性化推荐</text>
          <text class="setting-desc">根据口味推荐店铺</text>
        </view>
        <van-switch checked="{{personalized}}" active-color="#b9e83e" size="22px" data-field="personalized" bind:change="toggle" />
      </view>
    </view>
  </view>

  <view class="settings-group">
    <view class="group-label">隐私与通用</view>
    <view class="group-card">
      <view class="setting-row">
        <view class="setting-icon lime-bg">
          <image src="/assets/icons/pin.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">位置权限</text>
          <text class="setting-desc">用于推荐附近的校园好味</text>
        </view>
        <van-switch checked="{{location}}" active-color="#b9e83e" size="22px" data-field="location" bind:change="toggle" />
      </view>
      <view class="row-line"></view>
      <view class="setting-row" bindtap="clearCache">
        <view class="setting-icon sand-bg">
          <image src="/assets/icons/trash.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">清除缓存</text>
          <text class="setting-desc">搜索记录与临时文件</text>
        </view>
        <text class="setting-value">{{cacheSize}}</text>
        <image class="row-arrow" src="/assets/icons/chevron-right.svg" />
      </view>
      <view class="row-line"></view>
      <view class="setting-row" bindtap="showAgreement">
        <view class="setting-icon rose-bg">
          <image src="/assets/icons/shield.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">服务协议与隐私</text>
          <text class="setting-desc">我们如何保护你的数据</text>
        </view>
        <image class="row-arrow" src="/assets/icons/chevron-right.svg" />
      </view>
    </view>
  </view>

  <view class="settings-group">
    <view class="group-label">后端联调 · AXIOS + PINIA</view>
    <view class="group-card">
      <view class="setting-row">
        <view class="setting-icon mint-bg">
          <image src="/assets/icons/refresh.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">远程接口</text>
          <text class="setting-desc">关闭后仅使用本地示例数据</text>
        </view>
        <van-switch checked="{{useRemote}}" active-color="#b9e83e" size="22px" bind:change="toggleRemote" />
      </view>
      <view class="row-line"></view>
      <view class="setting-row" bindtap="editApiBase">
        <view class="setting-icon lime-bg">
          <image src="/assets/icons/spark.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">接口地址</text>
          <text class="setting-desc">{{apiBase}}</text>
        </view>
        <image class="row-arrow" src="/assets/icons/chevron-right.svg" />
      </view>
      <view class="row-line"></view>
      <view class="setting-row">
        <view class="setting-icon sand-bg">
          <image src="/assets/icons/check.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">连接状态</text>
          <text class="setting-desc">{{apiError || (lastSyncAt ? '最近同步 ' + lastSyncAt : '尚未同步')}}</text>
        </view>
        <van-tag round color="{{apiOnline ? '#18211a' : '#e7e5de'}}" text-color="{{apiOnline ? '#d7ff5e' : '#8a9189'}}">{{apiOnline ? 'ONLINE' : 'OFFLINE'}}</van-tag>
      </view>
    </view>
    <view class="api-actions">
      <van-button size="small" round custom-class="api-test-btn" loading="{{testing}}" bind:click="testConnection">测试连接</van-button>
      <van-button size="small" round plain custom-class="api-refresh-btn" bind:click="reload">重新同步</van-button>
    </view>
  </view>

  <view class="settings-group">
    <view class="group-label">关于</view>
    <view class="group-card">
      <view class="setting-row" bindtap="contactService">
        <view class="setting-icon mint-bg">
          <image src="/assets/icons/headset.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">联系客服</text>
          <text class="setting-desc">每天 08:00 - 24:00 在线</text>
        </view>
        <image class="row-arrow" src="/assets/icons/chevron-right.svg" />
      </view>
      <view class="row-line"></view>
      <view class="setting-row" bindtap="showAbout">
        <view class="setting-icon lime-bg">
          <image src="/assets/icons/spark.svg" />
        </view>
        <view class="setting-copy">
          <text class="setting-name">关于校园宿达</text>
          <text class="setting-desc">SUDA CAMPUS</text>
        </view>
        <text class="setting-value">1.0.0</text>
        <image class="row-arrow" src="/assets/icons/chevron-right.svg" />
      </view>
    </view>
  </view>

  <view class="logout-btn" bindtap="logout">退出登录</view>

  <view class="settings-foot">
    <view class="brand-badge">宿</view>
    <text>校园宿达 · 把好吃的送到楼下</text>
    <text>MADE FOR CAMPUS · 2026</text>
  </view>

  <van-popup z-index="{{1000}}" show="{{apiEditorVisible}}" position="bottom" round bind:close="closeApiEditor">
    <view class="api-editor">
      <text class="api-editor-title">接口地址</text>
      <text class="api-editor-desc">默认 {{defaultApiBase}} · 修改后会立即用 axios 重连</text>
      <van-field
        value="{{apiDraft}}"
        border="{{true}}"
        placeholder="http://localhost:8080/api"
        custom-class="api-editor-field"
        bind:change="onApiDraftChange"
      />
      <view class="api-editor-actions">
        <view class="api-editor-ghost" bindtap="resetApiBase">恢复默认</view>
        <view class="api-editor-primary" bindtap="saveApiBase">保存并重连</view>
      </view>
    </view>
  </van-popup>

  <van-dialog id="van-dialog" z-index="{{1000}}" />
  <van-toast id="van-toast" />
</view>
