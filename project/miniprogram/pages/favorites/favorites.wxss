.favorites-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: radial-gradient(circle at 88% 0%, rgba(215, 255, 94, 0.16) 0, rgba(244, 242, 236, 0) 32%), #f4f2ec;
}

.favorites-nav {
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.favorites-nav .nav-back {
  margin-left: -14rpx;
}

.favorites-nav-title {
  font-size: 30rpx;
  font-weight: 700;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

.favorites-hero {
  position: relative;
  margin: 16rpx 32rpx 0;
  padding: 28rpx;
  height: 210rpx;
  border-radius: 36rpx;
  background: #d7ff5e;
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 3;
}

.hero-eyebrow {
  color: #4b5a27;
  font-size: 15rpx;
  letter-spacing: 3rpx;
  font-weight: 800;
}

.hero-title-row {
  display: flex;
  align-items: flex-start;
  margin-top: 9rpx;
}

.hero-title {
  color: #18211a;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  line-height: 1;
}

.hero-dot {
  color: #18211a;
  font-size: 48rpx;
  line-height: 0.8;
}

.hero-sub {
  display: block;
  margin-top: 13rpx;
  color: #55633c;
  font-size: 18rpx;
}

.hero-heart {
  position: absolute;
  right: 40rpx;
  top: 30rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-heart image {
  width: 56rpx;
  height: 56rpx;
}

.hero-spark {
  position: absolute;
  right: 164rpx;
  bottom: 22rpx;
  color: #5b6c2a;
  font-size: 34rpx;
}

.favorites-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 38rpx 34rpx 20rpx;
}

.favorites-title {
  font-size: 33rpx;
  font-weight: 800;
}

.favorites-count {
  color: #a7ada4;
  font-size: 15rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
}

.favorite-wrap {
  position: relative;
}

.favorite-remove {
  position: absolute;
  right: 48rpx;
  top: 16rpx;
  z-index: 3;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.1);
}

.favorite-remove image {
  width: 18rpx;
  height: 18rpx;
}

.favorites-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 26rpx;
  color: #b0b5ad;
  font-size: 17rpx;
}

.foot-line {
  width: 50rpx;
  height: 1rpx;
  background: #dcd9d0;
}
