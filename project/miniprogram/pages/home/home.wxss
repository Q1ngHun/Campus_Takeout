.home-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.home-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 32rpx 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-mark {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #d7ff5e;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(185, 232, 62, 0.3);
}

.brand-mark text {
  font-size: 36rpx;
  font-weight: 900;
  color: #18211a;
  letter-spacing: -1rpx;
}

.brand-dot {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #18211a;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 29rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.brand-en {
  margin-top: 4rpx;
  font-size: 14rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
  color: #9aa096;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location {
  height: 58rpx;
  display: flex;
  align-items: center;
  gap: 5rpx;
  padding: 0 15rpx;
  border-radius: 29rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(24, 33, 26, 0.05);
}

.location image {
  width: 27rpx;
  height: 27rpx;
}

.location text {
  font-size: 21rpx;
  font-weight: 600;
  color: #3d473e;
}

.location .chevron {
  width: 19rpx;
  height: 19rpx;
  opacity: 0.55;
}

.bell {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(24, 33, 26, 0.05);
}

.bell image {
  width: 30rpx;
  height: 30rpx;
}

.notification-dot {
  position: absolute;
  right: 13rpx;
  top: 13rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff6b4a;
  border: 2rpx solid #ffffff;
}

.welcome {
  padding: 30rpx 34rpx 0;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.welcome-greeting {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.welcome-sub {
  font-size: 22rpx;
  color: #8b9289;
}

.search-bar {
  height: 86rpx;
  margin: 26rpx 32rpx 0;
  padding: 0 16rpx 0 26rpx;
  border-radius: 43rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 36rpx rgba(24, 33, 26, 0.05);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

.search-placeholder {
  flex: 1;
  margin-left: 16rpx;
  color: #a2a8a0;
  font-size: 25rpx;
}

.search-divider {
  width: 1rpx;
  height: 30rpx;
  background: #e8e6df;
}

.scan-btn {
  width: 60rpx;
  height: 60rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5ef;
}

.scan-btn image {
  width: 31rpx;
  height: 31rpx;
}

.hero-card {
  position: relative;
  height: 400rpx;
  margin: 28rpx 32rpx 0;
  padding: 32rpx;
  border-radius: 38rpx;
  background: #14251b;
  overflow: hidden;
  box-shadow: 0 20rpx 44rpx rgba(20, 37, 27, 0.16);
}

.hero-glow {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  right: -140rpx;
  top: -140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(215, 255, 94, 0.18) 0%, rgba(20, 37, 27, 0) 68%);
}

.hero-content {
  position: relative;
  z-index: 3;
  width: 62%;
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #a7b2a2;
  font-size: 16rpx;
  letter-spacing: 2.5rpx;
  font-weight: 700;
}

.live-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #d7ff5e;
}

.hero-title {
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 54rpx;
  line-height: 1.14;
  font-weight: 900;
  letter-spacing: -3rpx;
}

.hero-title-line {
  display: block;
  color: #d7ff5e;
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 26rpx;
  color: #aab4a6;
  font-size: 18rpx;
}

.avatar-stack {
  display: flex;
}

.mini-avatar {
  width: 38rpx;
  height: 38rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  border: 2rpx solid #14251b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  font-weight: 800;
  color: #18211a;
}

.mini-avatar:first-child {
  margin-left: 0;
}

.avatar-a {
  background: #d7ff5e;
}

.avatar-b {
  background: #f1d7b7;
}

.avatar-c {
  background: #ffffff;
}

.hero-art {
  position: absolute;
  right: -54rpx;
  top: 28rpx;
  width: 314rpx;
  height: 314rpx;
}

.hero-ring {
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(215, 255, 94, 0.42);
}

.hero-image {
  position: absolute;
  left: 38rpx;
  top: 38rpx;
  width: 238rpx;
  height: 238rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.1);
}

.hero-sticker {
  position: absolute;
  left: -6rpx;
  top: 40rpx;
  width: 122rpx;
  height: 70rpx;
  padding: 9rpx 12rpx;
  border-radius: 14rpx;
  background: #f4f2ec;
  transform: rotate(-8deg);
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.sticker-top {
  font-size: 14rpx;
  color: #8a9189;
  font-weight: 600;
}

.sticker-main {
  margin-top: 3rpx;
  font-size: 23rpx;
  font-weight: 900;
  color: #18211a;
  white-space: nowrap;
}

.hero-bubble {
  position: absolute;
  right: 80rpx;
  bottom: 6rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #d7ff5e;
  transform: rotate(4deg);
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.18);
}

.bubble-price {
  font-size: 24rpx;
  font-weight: 900;
  color: #18211a;
  line-height: 1.1;
}

.bubble-symbol {
  font-size: 16rpx;
}

.bubble-desc {
  margin-top: 2rpx;
  font-size: 13rpx;
  color: #4d5a44;
  font-weight: 600;
}

.hero-cta {
  position: absolute;
  left: 32rpx;
  bottom: 28rpx;
  z-index: 4;
  height: 64rpx;
  padding: 0 12rpx 0 26rpx;
  border-radius: 32rpx;
  background: #d7ff5e;
  color: #18211a;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.hero-cta-arrow {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #18211a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-cta-arrow image {
  width: 22rpx;
  height: 22rpx;
}

.category-grid {
  display: flex;
  justify-content: space-between;
  padding: 34rpx 30rpx 0;
}

.category-item {
  width: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-bubble {
  position: relative;
  width: 94rpx;
  height: 94rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.category-bubble image {
  width: 48rpx;
  height: 48rpx;
}

.tone-lime {
  background: #e7f4c7;
}

.tone-sand {
  background: #f3e8d6;
}

.tone-mint {
  background: #dcefe5;
}

.tone-peach {
  background: #ffe2d6;
}

.tone-rose {
  background: #f6e0e5;
}

.category-item.active .category-bubble {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 24rpx rgba(24, 33, 26, 0.12);
}

.active-indicator {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #18211a;
  border: 3rpx solid #ffffff;
}

.category-name {
  margin-top: 13rpx;
  font-size: 21rpx;
  color: #7d857d;
  white-space: nowrap;
  transition: color 0.2s ease;
}

.category-item.active .category-name {
  color: #18211a;
  font-weight: 800;
}

.promo-strip {
  height: 118rpx;
  margin: 32rpx 32rpx 0;
  padding: 0 22rpx 0 18rpx;
  border-radius: 28rpx;
  background: #d7ff5e;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.promo-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.promo-label {
  width: 66rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: #18211a;
  color: #d7ff5e;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.promo-copy {
  display: flex;
  flex-direction: column;
}

.promo-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #18211a;
}

.promo-desc {
  margin-top: 5rpx;
  font-size: 19rpx;
  color: #55633c;
}

.promo-cta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  font-weight: 800;
  color: #18211a;
}

.promo-cta image {
  width: 22rpx;
  height: 22rpx;
}

.section-head {
  margin-top: 46rpx;
}

.section-sub {
  display: block;
}

.hot-scroll {
  margin-top: 24rpx;
  width: 100%;
  white-space: nowrap;
}

.hot-list {
  display: flex;
  gap: 18rpx;
  padding: 0 32rpx;
}

.hot-card {
  position: relative;
  width: 296rpx;
  height: 330rpx;
  flex-shrink: 0;
  border-radius: 30rpx;
  overflow: hidden;
  background: #1f2a20;
}

.hot-cover {
  width: 100%;
  height: 100%;
}

.hot-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 210rpx;
  background: linear-gradient(180deg, rgba(10, 16, 12, 0) 0%, rgba(10, 16, 12, 0.86) 100%);
}

.hot-index {
  position: absolute;
  left: 20rpx;
  top: 16rpx;
  font-family: "DIN Alternate", "Arial Black", sans-serif;
  font-size: 50rpx;
  font-weight: 900;
  color: #d7ff5e;
  line-height: 1;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}

.hot-rating {
  position: absolute;
  right: 16rpx;
  top: 18rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 19rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #18211a;
  font-size: 18rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.hot-bottom {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.hot-name {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 18rpx;
}

.hot-time {
  color: #d7ff5e;
  font-weight: 700;
}

.feed-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 32rpx;
  margin: 48rpx 0 24rpx;
}

.feed-filter {
  height: 50rpx;
  padding: 0 16rpx;
  border-radius: 25rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 7rpx;
  font-size: 21rpx;
  color: #677066;
  box-shadow: 0 5rpx 16rpx rgba(24, 33, 26, 0.04);
}

.feed-filter image {
  width: 21rpx;
  height: 21rpx;
}

.feed-list {
  display: flex;
  flex-direction: column;
}

.feed-end {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 28rpx 32rpx 20rpx;
  color: #b0b5ad;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.end-line {
  width: 54rpx;
  height: 1rpx;
  background: #dcd9d0;
}

.floating-cart {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(146rpx + env(safe-area-inset-bottom));
  height: 106rpx;
  z-index: 800;
  padding: 0 16rpx 0 18rpx;
  border-radius: 53rpx;
  background: #18211a;
  box-shadow: 0 20rpx 44rpx rgba(24, 33, 26, 0.26);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cart-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #d7ff5e;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-icon image {
  width: 36rpx;
  height: 36rpx;
}

.cart-count {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: #ff6b4a;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #18211a;
}

.cart-copy {
  display: flex;
  flex-direction: column;
}

.cart-total {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.cart-symbol {
  font-size: 20rpx;
}

.cart-shop {
  margin-top: 5rpx;
  color: #9aa496;
  font-size: 18rpx;
}

.cart-checkout {
  height: 76rpx;
  padding: 0 20rpx 0 28rpx;
  border-radius: 38rpx;
  background: #d7ff5e;
  color: #18211a;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cart-checkout image {
  width: 28rpx;
  height: 28rpx;
}


.home-notice {
  margin: 0 40rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  font-size: 22rpx;
  line-height: 64rpx;
  --notice-bar-height: 64rpx;
}

