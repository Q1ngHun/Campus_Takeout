<view class="page-plain checkout-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px"></view>

  <view class="checkout-nav">
    <view class="nav-back" bindtap="goBack">
      <image src="/assets/icons/chevron-left.svg" />
    </view>
    <text class="checkout-nav-title">确认订单</text>
    <view class="nav-placeholder"></view>
  </view>

  <block wx:if="{{count}}">
    <view class="checkout-hero">
      <text class="eyebrow">CHECKOUT</text>
      <view class="checkout-title-row">
        <text class="checkout-title">最后一步</text>
        <text class="checkout-dot">.</text>
      </view>
      <text class="checkout-sub">确认信息，好味马上出发</text>
    </view>

    <view class="address-card" bindtap="chooseAddress">
      <view class="address-top">
        <view class="address-pin">
          <image src="/assets/icons/pin.svg" />
        </view>
        <view class="address-copy">
          <view class="address-person">
            <text class="address-name">{{address.name}}</text>
            <text class="address-phone">{{address.phone}}</text>
            <view class="address-label">{{address.label}}</view>
          </view>
          <text class="address-detail">{{address.detail}}</text>
          <text class="address-note">{{address.note || '请送至宿舍楼下，到楼电话联系'}}</text>
        </view>
        <view class="address-arrow">
          <image src="/assets/icons/chevron-right.svg" />
        </view>
      </view>
      <view class="address-dash"></view>
      <view class="address-foot">
        <view class="address-live">
          <view class="live-dot"></view>
          <text>校园直送 · 骑手可送达宿舍门口</text>
        </view>
        <text class="address-change">修改</text>
      </view>
    </view>

    <view class="delivery-card" bindtap="chooseDelivery">
      <view class="delivery-left">
        <view class="delivery-icon">
          <image src="/assets/icons/clock.svg" />
        </view>
        <view class="delivery-copy">
          <text class="delivery-title">{{deliveryMode === 'now' ? '立即送出' : '预约配送'}}</text>
          <text class="delivery-time">{{deliveryTime}}</text>
        </view>
      </view>
      <view class="delivery-change">
        <text>修改</text>
        <image src="/assets/icons/chevron-right.svg" />
      </view>
    </view>

    <view class="order-card">
      <view class="order-shop">
        <image src="{{shop.cover}}" mode="aspectFill" />
        <text>{{shop.name}}</text>
        <view class="order-shop-badge">校园直送</view>
      </view>

      <view class="order-item" wx:for="{{cartItems}}" wx:key="dishId">
        <image class="order-item-image" src="{{item.image}}" mode="aspectFill" />
        <view class="order-item-copy">
          <text class="order-item-name">{{item.name}}</text>
          <text class="order-item-spec">{{item.spec}}</text>
        </view>
        <view class="order-item-right">
          <text class="order-item-qty">×{{item.qty}}</text>
          <text class="order-item-price">¥{{item.price}}</text>
        </view>
      </view>

      <view class="order-subtotal">
        <text>共 {{count}} 件</text>
        <text>小计 <text class="subtotal-price">¥{{subtotal}}</text></text>
      </view>
    </view>

    <view class="options-card">
      <view class="option-row" bindtap="chooseCoupon">
        <view class="option-icon coupon-bg">
          <image src="/assets/icons/coupon.svg" />
        </view>
        <text class="option-label">优惠券</text>
        <text class="option-value {{coupon ? 'highlight' : ''}}">{{coupon ? coupon.title + '  -¥' + discount : '选择优惠券'}}</text>
        <image class="option-arrow" src="/assets/icons/chevron-right.svg" />
      </view>

      <view class="option-line"></view>

      <view class="option-row remark-row">
        <view class="option-icon remark-bg">
          <image src="/assets/icons/edit.svg" />
        </view>
        <text class="option-label">订单备注</text>
        <input
          class="remark-input"
          maxlength="40"
          placeholder="口味、门禁或送达要求"
          placeholder-class="remark-placeholder"
          value="{{remark}}"
          bindinput="onRemarkInput"
        />
      </view>

      <view class="option-line"></view>

      <view class="option-row" bindtap="chooseTableware">
        <view class="option-icon tableware-bg">
          <image src="/assets/icons/bag.svg" />
        </view>
        <text class="option-label">餐具份数</text>
        <text class="option-value">{{tableware}}</text>
        <image class="option-arrow" src="/assets/icons/chevron-right.svg" />
      </view>

      <view class="option-line"></view>

      <view class="option-row" bindtap="choosePay">
        <view class="option-icon pay-bg">
          <image src="/assets/icons/wallet.svg" />
        </view>
        <text class="option-label">支付方式</text>
        <text class="option-value">{{payMethod}}</text>
        <image class="option-arrow" src="/assets/icons/chevron-right.svg" />
      </view>
    </view>

    <view class="bill-card">
      <view class="bill-head">
        <text class="bill-title">费用明细</text>
        <text class="bill-small">DETAILS</text>
      </view>
      <view class="bill-row">
        <text>商品小计</text>
        <text>¥{{subtotal}}</text>
      </view>
      <view class="bill-row">
        <text>配送费</text>
        <text>¥{{deliveryFee}}</text>
      </view>
      <view class="bill-row discount" wx:if="{{discount}}">
        <text>优惠券</text>
        <text>-¥{{discount}}</text>
      </view>
      <view class="bill-total">
        <text>实付</text>
        <text class="bill-total-price"><text>¥</text>{{total}}</text>
      </view>
    </view>

    <view class="checkout-policy">
      <image src="/assets/icons/shield.svg" />
      <text>提交即同意《校园宿达服务协议》· 校园安心送 · 超时赔付</text>
    </view>

    <view class="checkout-space"></view>

    <view class="submit-bar">
      <view class="submit-total">
        <text class="submit-label">合计</text>
        <text class="submit-price"><text>¥</text>{{total}}</text>
        <text class="submit-saved" wx:if="{{discount}}">已省 ¥{{discount}}</text>
      </view>
      <view class="submit-btn {{submitting ? 'submitting' : ''}}" bindtap="submitOrder">
        <text>{{submitting ? '正在下单…' : '提交订单'}}</text>
        <image src="/assets/icons/arrow.svg" />
      </view>
    </view>
  </block>

  <empty-state
    wx:else
    icon="bag"
    title="购物车是空的"
    desc="先去挑一份喜欢的餐品，再来结算吧"
    action="去首页点单"
    bind:action="goHome"
  />
</view>
