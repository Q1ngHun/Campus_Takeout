.shop-card {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  margin: 0 32rpx 24rpx;
  background: #ffffff;
  border-radius: 34rpx;
  box-shadow: 0 12rpx 40rpx rgba(24, 33, 26, 0.045);
}

.cover-wrap {
  position: relative;
  width: 220rpx;
  height: 240rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #ece9df;
}

.cover {
  width: 100%;
  height: 100%;
}

.rank-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  max-width: 180rpx;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  background: #d7ff5e;
  color: #18211a;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

.time-badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  gap: 5rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  background: rgba(20, 29, 22, 0.82);
  backdrop-filter: blur(8rpx);
  color: #f7ffe8;
  font-size: 19rpx;
  font-weight: 600;
}

.time-badge image {
  width: 20rpx;
  height: 20rpx;
}

.shop-info {
  flex: 1;
  min-width: 0;
  padding: 6rpx 0 2rpx;
  display: flex;
  flex-direction: column;
}

.shop-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.shop-name {
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rating {
  display: flex;
  align-items: center;
  gap: 3rpx;
  flex-shrink: 0;
  color: #18211a;
  font-size: 22rpx;
  font-weight: 800;
}

.star {
  font-size: 19rpx;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  color: #8a9189;
  font-size: 20rpx;
  white-space: nowrap;
}

.dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #c9ccc5;
  margin: 0 9rpx;
}

.tags {
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-top: 14rpx;
  overflow: hidden;
}

.tag {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 7rpx;
  background: #f2f4ee;
  color: #687268;
  font-size: 18rpx;
}

.coupon-line {
  display: flex;
  align-items: center;
  margin-top: auto;
  gap: 10rpx;
}

.coupon {
  display: flex;
  align-items: center;
  gap: 5rpx;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #fff1ec;
  color: #f05a3b;
  font-size: 18rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.coupon-icon {
  width: 24rpx;
  height: 24rpx;
  line-height: 24rpx;
  text-align: center;
  border-radius: 5rpx;
  background: #ff6b4a;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 700;
}

.hot-dish {
  flex: 1;
  min-width: 0;
  color: #8a9189;
  font-size: 19rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.add-btn {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #18211a;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(24, 33, 26, 0.18);
}

.add-btn image {
  width: 26rpx;
  height: 26rpx;
}
